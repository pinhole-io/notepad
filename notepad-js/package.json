{
  "name": "notepad-js",
  "version": "1.0.0",
  "description": "Node.js bindings for the notepad Rust core (napi-rs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinhole-io/notepad.git",
    "directory": "notepad-js"
  },
  "homepage": "https://github.com/pinhole-io/notepad",
  "bugs": {
    "url": "https://github.com/pinhole-io/notepad/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md"
  ],
  "napi": {
    "binaryName": "notepad-js",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "npm run build:debug && node scripts/copy-bridge.mjs && node scripts/ensure-superglue.mjs && node test/run.mjs && node test/superglue_integration.mjs",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
